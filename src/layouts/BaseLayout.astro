---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../consts';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
}

const {
  title = SITE.title,
  description = SITE.description,
  image = '/social-card.svg',
  article = false,
} = Astro.props;
const english = Astro.url.pathname.startsWith('/en/');
const koreanPath = Astro.url.pathname.replace(/^\/en(?=\/|$)/, '') || '/';
const pageTitle = title === SITE.title ? title : `${title} | ${SITE.title}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang={english ? "en" : "ko"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <script is:inline data-default-language>
      (() => {
        // Keep explicit article URLs stable; choose a default only at the entrance.
        if (location.pathname !== '/') return;
        const requested = new URLSearchParams(location.search).get('lang');
        let preferred = requested === 'ko' || requested === 'en' ? requested : null;
        try {
          if (preferred) localStorage.setItem('blog-language', preferred);
          else preferred = localStorage.getItem('blog-language');
        } catch {
          // An explicit Korean link still works when storage is blocked.
        }
        if (preferred !== 'ko') {
          location.replace('/en/' + location.search + location.hash);
        }
      })();
    </script>
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
      crossorigin="anonymous"
    />
    <link rel="canonical" href={canonicalURL} />
    {Astro.url.pathname !== '/404/' && <>
    <link rel="alternate" hreflang="ko" href={new URL(koreanPath, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL('/en' + koreanPath, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL('/en' + koreanPath, Astro.site)} />
    </>}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:locale" content={english ? "en_US" : "ko_KR"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        const storageKey = `scroll-position:${location.pathname}${location.search}`;
        const navigationEntry = performance.getEntriesByType('navigation')[0];
        const isHistoryNavigation = navigationEntry?.type === 'back_forward';

        history.scrollRestoration = 'manual';

        const savePosition = () => {
          sessionStorage.setItem(storageKey, JSON.stringify({ x: scrollX, y: scrollY }));
        };

        const restorePosition = () => {
          const savedPosition = sessionStorage.getItem(storageKey);
          if (!savedPosition) return;

          try {
            const { x, y } = JSON.parse(savedPosition);
            const previousBehavior = document.documentElement.style.scrollBehavior;
            document.documentElement.style.scrollBehavior = 'auto';
            scrollTo(x, y);
            document.documentElement.style.scrollBehavior = previousBehavior;
          } catch {
            sessionStorage.removeItem(storageKey);
          }
        };

        addEventListener('pagehide', savePosition, { capture: true });
        addEventListener('pageshow', (event) => {
          if (event.persisted || isHistoryNavigation) restorePosition();
        });
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">본문으로 바로가기</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
