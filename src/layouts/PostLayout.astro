---
import BaseLayout from './BaseLayout.astro';
import { CATEGORY_LABELS } from '../consts';
import { cleanDescription, formatDate, readingTime, type Post } from '../utils/posts';

interface Props {
  post: Post;
  previous?: Post;
  next?: Post;
  headings: { depth: number; slug: string; text: string }[];
}

const { post, previous, next, headings } = Astro.props;
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const hasToc = toc.length >= 3;
const isBook = post.data.category === 'Books';
const usesSplitBookBody = isBook && post.data.title === '싯다르타';
---

<BaseLayout title={post.data.title} description={post.data.description} article>
  <article class:list={['article-shell', `category-${post.data.category.toLocaleLowerCase()}`, { 'has-toc': hasToc, 'is-book-post': isBook, 'uses-split-book-body': usesSplitBookBody }]}>
    <header class="article-header">
      <div class="post-meta">
        <a href={`/categories/${post.data.category.toLocaleLowerCase()}/`}>
          {CATEGORY_LABELS[post.data.category]}
        </a>
        <span aria-hidden="true">·</span>
        <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
        <span aria-hidden="true">·</span>
        <span>{readingTime(post.body ?? '')}분 읽기</span>
      </div>
      <h1>{post.data.title}</h1>
      {!isBook && <p>{cleanDescription(post.data.description)}</p>}
      <div class="tag-row">
        {post.data.tags.map((tag) => <a href={`/tags/${encodeURIComponent(tag.toLocaleLowerCase())}/`}>#{tag}</a>)}
        {isBook && post.data.book?.rating !== undefined && (
          <span class="article-rating" aria-label={`평점 ${post.data.book.rating}점`}>
            <span aria-hidden="true">★</span> {post.data.book.rating}
          </span>
        )}
      </div>
    </header>

    {
      hasToc && (
        <details class="mobile-toc" data-mobile-toc>
          <summary>
            <span>이 글의 목차</span>
            <small>{toc.length}개</small>
          </summary>
          <ol>
            {toc.map((heading) => (
              <li class:list={{ nested: heading.depth === 3 }}>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ol>
        </details>
      )
    }

    <div class:list={['article-grid', { 'without-toc': !hasToc }]}>
      <div class="prose">
        <slot />
      </div>
      {
        hasToc && (
          <aside class="toc" aria-label="목차" data-article-toc>
            <strong>목차</strong>
            <ol>
              {toc.map((heading) => (
                <li class:list={{ nested: heading.depth === 3 }}>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </aside>
        )
      }
    </div>

    <nav class="post-navigation" aria-label="이전 및 다음 글">
      {
        previous ? (
          <a class="previous" href={`/posts/${previous.id}/`}>
            <span>이전 글</span>
            <strong>{previous.data.title}</strong>
          </a>
        ) : <span />
      }
      {
        next && (
          <a class="next" href={`/posts/${next.id}/`}>
            <span>다음 글</span>
            <strong>{next.data.title}</strong>
          </a>
        )
      }
    </nav>

    <a class="back-link" href="/posts/"><span aria-hidden="true">←</span> 전체 글 보기</a>
  </article>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>('[data-mobile-toc]').forEach((toc) => {
    toc.querySelectorAll<HTMLAnchorElement>('a').forEach((link) => {
      link.addEventListener('click', () => toc.removeAttribute('open'));
    });
  });

  document.querySelectorAll<HTMLElement>('[data-article-toc]').forEach((toc) => {
    const links = Array.from(toc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]'));
    const headings = links
      .map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
      .filter((heading): heading is HTMLElement => Boolean(heading));
    if (!headings.length) return;

    const updateCurrent = () => {
      const current = headings.reduce(
        (active, heading) => heading.getBoundingClientRect().top <= 120 ? heading : active,
        headings[0],
      );
      links.forEach((link) => {
        const selected = decodeURIComponent(link.hash.slice(1)) === current.id;
        if (selected) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
    };

    document.addEventListener('scroll', updateCurrent, { passive: true });
    updateCurrent();
  });
</script>
