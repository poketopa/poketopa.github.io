---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArchiveExplorer from '../../components/ArchiveExplorer.astro';
import BrandCover from '../../components/BrandCover.astro';
import CategoryTabs from '../../components/CategoryTabs.astro';
import CategorySummary from '../../components/CategorySummary.astro';
import BookViewSwitcher from '../../components/BookViewSwitcher.astro';
import SubcategoryFilters from '../../components/SubcategoryFilters.astro';
import { CATEGORY_LABELS, type Category } from '../../consts';
import { getPublishedPosts } from '../../utils/posts';
import { getSubcategoryState } from '../../utils/subcategories';

export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  return Object.entries(CATEGORY_LABELS).map(([category, label]) => ({
    params: { category: category.toLocaleLowerCase() },
    props: { category: category as Category, label, posts: posts.filter((post) => post.data.category === category) },
  }));
}) satisfies GetStaticPaths;

const { category, label, posts } = Astro.props;
const subcategories = getSubcategoryState(category, posts);
---

<BaseLayout title={label} description={`${label} 분류의 글`}>
  <BrandCover />

  <div class="index-shell container">
    <CategoryTabs active={category.toLocaleLowerCase()} />
    {category === 'Books' && posts.length > 0 ? (
      <BookViewSwitcher posts={posts} />
    ) : (
      <section class="index-list" aria-label={`${label} 글`}>
        {
          posts.length > 0 ? (
            <ArchiveExplorer posts={posts} label={`${label} 기록`} topicsByPostId={subcategories?.topicsByPostId}>
              {subcategories && <SubcategoryFilters slot="filters" items={subcategories.items} label={`${label} 태그 필터`} />}
              <CategorySummary slot="summary" category={category} count={posts.length} />
            </ArchiveExplorer>
          ) : (
            <div class="category-overview">
              <CategorySummary category={category} count={posts.length} />
              <p class="empty-state">아직 공개된 글이 없습니다.</p>
            </div>
          )
        }
      </section>
    )}
  </div>
</BaseLayout>
