---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArchiveExplorer from '../components/ArchiveExplorer.astro';
import CategoryTabs from '../components/CategoryTabs.astro';
import CategorySummary from '../components/CategorySummary.astro';
import { getPublishedPosts } from '../utils/posts';

const posts = await getPublishedPosts();
---

<BaseLayout>
  <div class="index-shell container">
    <CategoryTabs active="all" />
    <section class="index-list" aria-label="전체 글">
      {
        posts.length > 0 ? (
          <ArchiveExplorer posts={posts} label="전체 기록">
            <CategorySummary slot="summary" category="all" count={posts.length} />
          </ArchiveExplorer>
        ) : (
          <div class="empty-state">
            <strong>첫 번째 기록을 준비하고 있어요.</strong>
            <p>개발, 회고, 독서에 대한 글이 이곳에 쌓입니다.</p>
          </div>
        )
      }
    </section>
  </div>
</BaseLayout>
