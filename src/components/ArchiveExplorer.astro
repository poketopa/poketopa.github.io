---
import type { Post } from '../utils/posts';
import PostList from './PostList.astro';

interface Props {
  posts: Post[];
  label?: string;
  pageSize?: number;
  featuredId?: string;
}

const { posts, label = '기록', pageSize = 12, featuredId } = Astro.props;
const years = [...new Set(posts.map((post) => post.data.publishedAt.getFullYear()))].sort((a, b) => b - a);
const yearGroups = years.map((year) => ({
  year,
  posts: posts.filter((post) => post.data.publishedAt.getFullYear() === year),
}));
---

<section class="archive-explorer" data-archive-explorer data-page-size={pageSize} data-featured-id={featuredId} aria-label={`${label} 찾기`}>
  <div class="archive-tools" role="search" aria-label={`${label} 검색`}>
    <label class="archive-search">
      <span class="sr-only">{label} 검색</span>
      <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16">
        <circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
        <path d="m16 16 4 4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.8"></path>
      </svg>
      <input type="search" placeholder="기록 검색" autocomplete="off" data-archive-search />
    </label>
  </div>

  <div class="archive-feedback">
    <p aria-live="polite" data-archive-status></p>
    <button type="button" data-archive-reset hidden>필터 초기화</button>
  </div>
  <div class="archive-year-groups" data-archive-results>
    {
      yearGroups.map(({ year, posts: yearPosts }) => (
        <section class="archive-year-group" data-archive-year-group={year} aria-labelledby={`archive-year-${year}`}>
          <header class="archive-year-heading">
            <h3 id={`archive-year-${year}`}>{year}</h3>
            <p data-archive-year-count>{yearPosts.length}개의 기록</p>
          </header>
          <PostList posts={yearPosts} />
        </section>
      ))
    }
  </div>
  <p class="archive-empty" data-archive-empty hidden>조건에 맞는 기록이 없습니다.</p>
  <button class="load-more-button" type="button" data-archive-more hidden>기록 더 보기</button>
</section>

<script>
  const normalizeArchiveText = (value: string) => value.normalize('NFKC').toLocaleLowerCase('ko-KR').trim();

  document.querySelectorAll<HTMLElement>('[data-archive-explorer]').forEach((explorer) => {
    const search = explorer.querySelector<HTMLInputElement>('[data-archive-search]');
    const status = explorer.querySelector<HTMLElement>('[data-archive-status]');
    const reset = explorer.querySelector<HTMLButtonElement>('[data-archive-reset]');
    const empty = explorer.querySelector<HTMLElement>('[data-archive-empty]');
    const more = explorer.querySelector<HTMLButtonElement>('[data-archive-more]');
    const groupsRoot = explorer.querySelector<HTMLElement>('[data-archive-results]');
    const groups = Array.from(explorer.querySelectorAll<HTMLElement>('[data-archive-year-group]'));
    const items = Array.from(explorer.querySelectorAll<HTMLElement>('[data-post-item]'));
    const pageSize = Number(explorer.dataset.pageSize) || 12;
    const featuredId = explorer.dataset.featuredId;
    let visibleLimit = pageSize;

    const applyFilters = () => {
      const query = normalizeArchiveText(search?.value ?? '');
      const isFiltered = Boolean(query);

      const matching = items.filter((item) => {
        if (!isFiltered && featuredId && item.dataset.postId === featuredId) return false;
        return normalizeArchiveText(item.dataset.search ?? '').includes(query);
      });

      matching.sort((a, b) => Number(b.dataset.date) - Number(a.dataset.date));

      const matchingSet = new Set(matching);
      matching.forEach((item, index) => { item.hidden = index >= visibleLimit; });
      items.filter((item) => !matchingSet.has(item)).forEach((item) => { item.hidden = true; });

      groups.forEach((group) => {
        const groupYear = group.dataset.archiveYearGroup;
        const groupList = group.querySelector<HTMLElement>('.post-list');
        const groupMatches = matching.filter((item) => item.dataset.year === groupYear);
        const groupMatchSet = new Set(groupMatches);
        const groupItems = items.filter((item) => item.dataset.year === groupYear);
        [...groupMatches, ...groupItems.filter((item) => !groupMatchSet.has(item))].forEach((item) => groupList?.append(item));

        const visibleInGroup = groupMatches.filter((item) => !item.hidden).length;
        group.hidden = visibleInGroup === 0;
        const count = group.querySelector<HTMLElement>('[data-archive-year-count]');
        if (count) count.textContent = `${groupMatches.length}개의 기록`;
        groupsRoot?.append(group);
      });

      const shown = Math.min(visibleLimit, matching.length);
      if (status) status.textContent = `${matching.length}개 중 ${shown}개 표시`;
      if (reset) reset.hidden = !isFiltered;
      if (empty) empty.hidden = matching.length !== 0;
      if (more) {
        const remaining = Math.max(0, matching.length - shown);
        more.hidden = remaining === 0;
        more.textContent = remaining ? `${Math.min(pageSize, remaining)}개 더 보기` : '기록 더 보기';
      }
    };

    const restart = () => {
      visibleLimit = pageSize;
      applyFilters();
    };

    search?.addEventListener('input', restart);
    reset?.addEventListener('click', () => {
      if (search) search.value = '';
      restart();
      search?.focus();
    });
    more?.addEventListener('click', () => {
      visibleLimit += pageSize;
      applyFilters();
    });

    applyFilters();
  });
</script>
