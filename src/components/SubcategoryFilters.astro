---
import type { SubcategoryItem } from '../utils/subcategories';

interface Props {
  items: SubcategoryItem[];
  label: string;
}

const { items, label } = Astro.props;
---

<nav class="subcategory-filters" aria-label={label}>
  {
    items.map((item) => (
      <button type="button" data-archive-topic={item.key} aria-pressed="false">
        <span>{item.label}</span>
        <small>{item.count}</small>
      </button>
    ))
  }
</nav>

<style>
  .subcategory-filters {
    display: flex;
    padding: 18px 4px 0;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px clamp(20px, 2.8vw, 34px);
  }

  button {
    position: relative;
    display: inline-flex;
    min-height: 30px;
    padding: 0 0 7px;
    border: 0;
    background: transparent;
    color: var(--text-faint);
    cursor: pointer;
    font: inherit;
    font-size: 0.86rem;
    font-weight: 600;
    align-items: baseline;
    gap: 5px;
    transition: color 160ms ease;
  }

  button:hover,
  button[aria-pressed='true'] {
    color: var(--text);
  }

  button[aria-pressed='true']::after {
    position: absolute;
    right: 0;
    bottom: 2px;
    left: 0;
    height: 2px;
    background: var(--accent);
    content: '';
  }

  button:focus-visible {
    border-radius: 2px;
    outline: 2px solid var(--focus);
    outline-offset: 4px;
  }

  small {
    color: var(--text-muted);
    font-size: 0.68rem;
    font-weight: 550;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 720px) {
    .subcategory-filters {
      padding-top: 14px;
      gap: 8px 20px;
    }

    button {
      min-height: 32px;
      font-size: 0.82rem;
    }
  }
</style>
