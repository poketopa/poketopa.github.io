---
interface Props {
  name: 'github' | 'rss' | 'arrow' | 'shelf' | 'list';
  size?: number;
}

const { name, size = 20 } = Astro.props;

const paths = {
  github: '<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3.3-.4 6.8-1.6 6.8-7A5.4 5.4 0 0 0 19.4 4 5 5 0 0 0 19.3.5S18.2.1 15 1.8a13.4 13.4 0 0 0-7 0C4.8.1 3.7.5 3.7.5A5 5 0 0 0 3.6 4a5.4 5.4 0 0 0-1.4 3.7c0 5.4 3.5 6.6 6.8 7A4.8 4.8 0 0 0 8 18v4"></path><path d="M8 19c-3 .9-3-1.5-4-2"></path>',
  rss: '<path d="M4 11a9 9 0 0 1 9 9"></path><path d="M4 4a16 16 0 0 1 16 16"></path><circle cx="5" cy="19" r="1"></circle>',
  arrow: '<path d="m9 18 6-6-6-6"></path>',
  shelf: '<path d="M3.5 19.5h17"></path><rect x="5" y="7" width="3.5" height="10" rx="0.7"></rect><rect x="10.25" y="4.5" width="3.5" height="12.5" rx="0.7"></rect><path d="m16 6.8 3.1-.8 2.6 10.2-3.1.8z"></path>',
  list: '<path d="M9 6.5h10.5M9 12h10.5M9 17.5h10.5"></path><circle cx="4.75" cy="6.5" r="0.85" fill="currentColor" stroke="none"></circle><circle cx="4.75" cy="12" r="0.85" fill="currentColor" stroke="none"></circle><circle cx="4.75" cy="17.5" r="0.85" fill="currentColor" stroke="none"></circle>',
};
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={paths[name]}
/>
