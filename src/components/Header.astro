---
import Icon from './Icon.astro';
import { SITE } from '../consts';
---

<header class="site-header">
  <div class="header-inner">
    <a class="wordmark" href="/" aria-label="Ludens.dev 홈">Ludens.dev</a>
    <div class="header-actions">
      <a class="icon-button" href={SITE.github} target="_blank" rel="noreferrer" aria-label="Ludens GitHub" title="GitHub">
        <Icon name="github" />
      </a>
      <button class="icon-button theme-toggle" type="button" aria-label="테마 전환" title="테마 전환">
        <span class="sun-icon"><Icon name="sun" /></span>
        <span class="moon-icon"><Icon name="moon" /></span>
      </button>
    </div>
  </div>
</header>
