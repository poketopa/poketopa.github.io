---
import Icon from './Icon.astro';
import { SITE } from '../consts';
---

<header class="site-header">
  <div class="header-inner">
    <a class="wordmark" href="/" aria-label="ludens.dev 홈">ludens.dev</a>
    <div class="header-actions">
      <a class="icon-button" href={SITE.github} target="_blank" rel="noreferrer" aria-label="ludens GitHub" title="GitHub">
        <Icon name="github" />
      </a>
    </div>
  </div>
</header>
