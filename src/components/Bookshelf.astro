---
import { cleanDescription, type Post } from '../utils/posts';

interface Props {
  posts: Post[];
  showNote?: boolean;
}

const { posts, showNote = true } = Astro.props;

const books = posts
  .filter((post) => post.data.book && post.data.cover)
  .map((post) => {
    const book = post.data.book!;

    return {
      ...post,
      book,
      style: `--book-color: ${book.spineColor};`,
    };
  });
---

<section class="bookshelf-section" aria-label="책장 보기">
  <div class="bookshelf-viewport" aria-label="표지가 보이는 읽은 책 진열대">
    <div class="bookshelf-stage">
      {
        books.map(({ id, data, book, style }, index) => (
          <a
            class="display-book"
            href={`/posts/${id}/`}
            style={style}
            aria-label={`${data.title}${book.author ? `, ${book.author}` : ''}${book.pageCount ? `, ${book.pageCount}쪽` : ''}${book.rating !== undefined ? `, 평점 ${book.rating}점` : ''}`}
            data-book-item
            data-year={data.publishedAt.getFullYear()}
            data-tags={JSON.stringify(data.tags)}
            data-search={`${data.title} ${book.author ?? ''} ${cleanDescription(data.description)} ${data.tags.join(' ')}`}
          >
            <span class="display-object">
              <span class="display-order" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <span class="display-cover">
                <img src={data.cover} alt="" loading={index < 3 ? 'eager' : 'lazy'} />
              </span>
              <span class="display-page-side" aria-hidden="true"></span>
              <span class="display-page-bottom" aria-hidden="true"></span>
            </span>
            <span class="display-caption">
              <strong>{data.title}</strong>
              <span class="display-caption-meta">
                {book.author && <small>{book.author}</small>}
                {book.rating !== undefined && <span class="display-rating" aria-label={`평점 ${book.rating}점`}>★ {book.rating}</span>}
              </span>
            </span>
          </a>
        ))
      }
    </div>
  </div>
  {
    showNote && (
      <div class="bookshelf-note">
        <p>표지나 제목을 선택하면 독후감으로 이동합니다.</p>
      </div>
    )
  }
</section>
