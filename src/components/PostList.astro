---
import type { Post } from '../utils/posts';
import { CATEGORY_LABELS } from '../consts';
import { formatDate, readingTime } from '../utils/posts';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

<div class="post-list">
  {
    posts.map((post) => (
      <article class="post-card">
        <div class="post-meta">
          <span>{formatDate(post.data.publishedAt)}</span>
          <span aria-hidden="true">·</span>
          <span>{readingTime(post.body ?? '')}분</span>
          <span aria-hidden="true">·</span>
          <a href={`/categories/${post.data.category.toLocaleLowerCase()}/`}>
            {CATEGORY_LABELS[post.data.category]}
          </a>
        </div>
        <h2><a href={`/posts/${post.id}/`}>{post.data.title}</a></h2>
        <p>{post.data.description}</p>
        <div class="tag-row" aria-label="태그">
          {post.data.tags.map((tag) => <a href={`/tags/${encodeURIComponent(tag.toLocaleLowerCase())}/`}>#{tag}</a>)}
        </div>
      </article>
    ))
  }
</div>
